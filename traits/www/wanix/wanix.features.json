{
  "trait": "www.wanix",
  "description": "Wanix shell runtime page",
  "features": [
    {
      "name": "Returns Wanix shell HTML",
      "description": "The wanix trait renders an embedded Wanix runtime shell page",
      "examples": [
        {
          "args": [],
          "test": {
            "type": "contains",
            "value": "Wanix Shell Runtime"
          }
        },
        {
          "args": [],
          "test": {
            "type": "contains",
            "value": "/static/wanix/index.html"
          }
        },
        {
          "args": [],
          "test": {
            "type": "contains",
            "value": "Shell active via local /static/wanix runtime"
          }
        }
      ]
    }
  ]
}

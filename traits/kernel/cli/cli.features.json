{
    "trait": "kernel.cli",
    "features": [
        {
            "name": "help command",
            "examples": [
                {
                    "input": ["help"],
                    "contains": ["Commands", "list", "info", "call", "search"]
                }
            ]
        },
        {
            "name": "help mentions @target dispatch",
            "examples": [
                {
                    "input": ["help"],
                    "contains": ["@rest", "rest, relay, helper, wasm, native"]
                }
            ]
        },
        {
            "name": "version command",
            "examples": [
                {
                    "input": ["version"],
                    "contains": ["traits.build"]
                }
            ]
        },
        {
            "name": "help lists unix-like semantic tools",
            "examples": [
                {
                    "input": ["help"],
                    "contains": ["Unix-like tools", "head", "tail", "grep", "sed", "find", "curl"]
                }
            ]
        },
        {
            "name": "help lists pipe and stdin redirection",
            "examples": [
                {
                    "input": ["help"],
                    "contains": ["cmd < file", "cmd1 | cmd2"]
                }
            ]
        },
        {
            "name": "help lists cwd and directory commands",
            "examples": [
                {
                    "input": ["help"],
                    "contains": ["pwd", "cd", "mkdir", "Change current directory"]
                }
            ]
        },
        {
            "name": "help lists logical chaining and enhanced userland flags",
            "examples": [
                {
                    "input": ["help"],
                    "contains": ["cmd1 && cmd2", "cmd1 || cmd2", "sed", "-mindepth", "vi/ee"]
                }
            ]
        },
        {
            "name": "rm recursively deletes directories",
            "examples": [
                {
                    "input": ["mkdir -p e2e_rm_recursive/sub && write e2e_rm_recursive/sub/file.txt hello && rm e2e_rm_recursive && ls e2e_rm_recursive"],
                    "contains": ["no such path"]
                }
            ]
        }
    ]
}

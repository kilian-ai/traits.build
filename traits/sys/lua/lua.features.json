{
  "trait": "sys.lua",
  "features": [
    {
      "name": "Run Lua print statements",
      "examples": [
        {
          "input": ["print('hello from lua')"],
          "output": { "contains": ["ok", "hello from lua"] }
        },
        {
          "input": ["__result = 2 + 3"],
          "output": { "contains": ["ok", "5"] }
        }
      ]
    }
  ]
}
